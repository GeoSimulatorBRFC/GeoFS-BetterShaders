(() => {

    "use strict";

    // --------------------------------------------------------------
    // SHADER CONFIGURATION
    // --------------------------------------------------------------

    const GeoFSShader = {

        version: "4.0.7",

        enabled: true,

        settings: {

            reflections: true,

            dynamicLighting: true,

            aircraftHighlights: true,

            glassReflection: true,

            environmentLighting: true,

            smoothTransitions: true,

            quality: "high"

        }

    };


    // --------------------------------------------------------------
    // INTERNAL STATE
    // --------------------------------------------------------------

    let shaderInitialized = false;

    let aircraftDetected = false;

    let environmentReady = false;

    let prankTriggered = false;


    // --------------------------------------------------------------
    // UTILITY FUNCTIONS
    // --------------------------------------------------------------

    function clamp(value, minimum, maximum) {

        return Math.max(
            minimum,
            Math.min(maximum, value)
        );

    }


    function lerp(start, end, amount) {

        return start + (end - start) * amount;

    }


    function createElement(type, properties = {}) {

        const element = document.createElement(type);

        Object.keys(properties).forEach(key => {

            try {

                element[key] = properties[key];

            } catch (error) {

                // Ignore unsupported properties.
            }

        });

        return element;

    }


    // --------------------------------------------------------------
    // AIRCRAFT REFLECTION ENGINE
    // --------------------------------------------------------------

    const ReflectionEngine = {

        intensity: 0.72,

        environmentStrength: 0.55,

        initialize() {

            this.intensity = clamp(
                this.intensity,
                0,
                1
            );

            this.environmentStrength = clamp(
                this.environmentStrength,
                0,
                1
            );

        },

        update() {

            if (!GeoFSShader.settings.reflections) {

                return;

            }

            const aircraftLight =
                lerp(
                    0.25,
                    1.0,
                    this.intensity
                );

            return aircraftLight;

        }

    };


    // --------------------------------------------------------------
    // DYNAMIC LIGHTING
    // --------------------------------------------------------------

    const LightingEngine = {

        sunIntensity: 1.0,

        ambientIntensity: 0.65,

        update() {

            if (!GeoFSShader.settings.dynamicLighting) {

                return;

            }

            this.sunIntensity =
                clamp(
                    this.sunIntensity,
                    0,
                    2
                );

            this.ambientIntensity =
                clamp(
                    this.ambientIntensity,
                    0,
                    1
                );

        }

    };


    // --------------------------------------------------------------
    // AIRCRAFT MATERIAL SYSTEM
    // --------------------------------------------------------------

    const AircraftMaterialSystem = {

        metallicResponse: 0.48,

        roughness: 0.32,

        paintReflection: 0.67,

        glassReflection: 0.82,

        initialize() {

            this.metallicResponse =
                clamp(
                    this.metallicResponse,
                    0,
                    1
                );

            this.roughness =
                clamp(
                    this.roughness,
                    0,
                    1
                );

        },

        calculateReflection(angle) {

            angle = clamp(
                angle,
                0,
                1
            );

            return lerp(
                this.paintReflection,
                this.glassReflection,
                angle
            );

        }

    };


    // --------------------------------------------------------------
    // ENVIRONMENT SYSTEM
    // --------------------------------------------------------------

    const EnvironmentSystem = {

        loaded: false,

        initialize() {

            this.loaded = true;

            environmentReady = true;

        },

        update() {

            if (!this.loaded) {

                return;

            }

        }

    };


    // --------------------------------------------------------------
    // GEOFS DETECTION
    // --------------------------------------------------------------

    function detectGeoFS() {

        try {

            if (
                typeof window !== "undefined" &&
                typeof document !== "undefined"
            ) {

                return true;

            }

        } catch (error) {

            return false;

        }

        return false;

    }


    // --------------------------------------------------------------
    // SHADER INITIALIZATION
    // --------------------------------------------------------------

    function initializeShader() {

        if (shaderInitialized) {

            return;

        }

        if (!detectGeoFS()) {

            console.warn(
                "[GeoFS Shader] Browser environment detected."
            );

        }

        ReflectionEngine.initialize();

        LightingEngine.update();

        AircraftMaterialSystem.initialize();

        EnvironmentSystem.initialize();

        shaderInitialized = true;

        aircraftDetected = true;

        console.log(
            "%c[GeoFS Shader] Aircraft reflection system initialized.",
            "color:#66ccff;font-weight:bold;"
        );

        console.log(
            "[GeoFS Shader] Environment lighting enabled."
        );

        console.log(
            "[GeoFS Shader] Material system ready."
        );

        console.log(
            "[GeoFS Shader] Shader quality:",
            GeoFSShader.settings.quality
        );

        startVisualEngine();

    }


    // --------------------------------------------------------------
    // VISUAL UPDATE LOOP
    // --------------------------------------------------------------

    function startVisualEngine() {

        let lastUpdate = 0;

        function render(timestamp) {

            if (
                timestamp - lastUpdate >
                100
            ) {

                ReflectionEngine.update();

                LightingEngine.update();

                EnvironmentSystem.update();

                lastUpdate = timestamp;

            }

            requestAnimationFrame(render);

        }

        requestAnimationFrame(render);

    }


